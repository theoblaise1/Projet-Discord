{#
    Thème de formulaire de l'application, basé sur le thème par défaut de Symfony.
    Il ajoute nos classes CSS et affiche les erreurs sous le champ concerné.
#}
{% use 'form_div_layout.html.twig' %}

{%- block form_row_render -%}
    {%- set row_class = ('field ' ~ row_attr.class|default('') ~ (errors|length > 0 ? ' has-error' : ''))|trim -%}
    <div{% with {attr: row_attr|merge({class: row_class})} %}{{ block('attributes') }}{% endwith %}>
        {{- form_label(form) -}}
        {{- form_widget(form, widget_attr) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock form_row_render -%}

{%- block form_label -%}
    {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' field__label')|trim}) -%}
    {{- parent() -}}
{%- endblock form_label -%}

{%- block form_label_content -%}
    {{- parent() -}}
    {%- if required -%}<span class="field__required" aria-hidden="true"> *</span>{%- endif -%}
{%- endblock form_label_content -%}

{%- block form_help -%}
    {%- set help_attr = help_attr|merge({class: (help_attr.class|default('') ~ ' field__help')|trim}) -%}
    {{- parent() -}}
{%- endblock form_help -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        <ul class="{{ form is rootform ? 'form-errors' : 'field__errors' }}" role="alert">
            {%- for error in errors -%}
                <li id="{{ id ~ '_error' ~ loop.index }}">{{ error.message }}</li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{%- endblock form_errors -%}

{%- block form_widget_simple -%}
    {%- if type|default('text') != 'hidden' -%}
        {%- set attr = attr|merge({class: attr.class|default('field__input')}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock form_widget_simple -%}

{%- block textarea_widget -%}
    {%- set attr = attr|merge({class: attr.class|default('field__input field__input--textarea')}) -%}
    {{- parent() -}}
{%- endblock textarea_widget -%}
