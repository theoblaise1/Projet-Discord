{# Mise en page des pages publiques (connexion, inscription) #}
{% extends 'base.html.twig' %}

{% block body_class %}page-auth{% endblock %}

{% block body %}
    <main class="auth">
        <div class="auth__card">
            <a href="{{ path('app_login') }}" class="auth__brand">
                <img src="{{ asset('images/logo.svg') }}" alt="" width="40" height="40">
                <span>{{ app_name }}</span>
            </a>

            {% block auth_content %}{% endblock %}
        </div>
    </main>
{% endblock %}
