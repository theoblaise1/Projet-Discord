{#
    Page d'erreur personnalisée (403, 404, 500…), affichée en production (APP_ENV=prod).
    En développement, Symfony affiche sa page de debug ; aperçu possible via /_error/404.
#}
{% extends 'base.html.twig' %}

{% block title %}Erreur {{ status_code }} | {{ app_name }}{% endblock %}

{% block body_class %}page-auth{% endblock %}

{% block body %}
    <main class="error-page">
        <div class="auth__card">
            <p class="error-page__code">{{ status_code }}</p>

            {% if status_code == 404 %}
                <h1 class="error-page__title">Page introuvable</h1>
                <p class="error-page__text">Ce salon ou cette page n'existe pas (ou plus).</p>
            {% elseif status_code == 403 %}
                <h1 class="error-page__title">Accès refusé</h1>
                <p class="error-page__text">Vous n'avez pas les droits nécessaires pour effectuer cette action.</p>
            {% else %}
                <h1 class="error-page__title">Une erreur est survenue</h1>
                <p class="error-page__text">Le serveur a rencontré un problème. Veuillez réessayer dans quelques instants.</p>
            {% endif %}

            <a href="{{ path('app_home') }}" class="btn btn--primary">Retour à l'accueil</a>
        </div>
    </main>
{% endblock %}
